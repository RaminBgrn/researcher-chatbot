# این فایل را کپی و اسمش را .env بگذار، بعد مقادیر واقعی را داخلش بنویس.
# فایل .env را با هیچ‌کس به اشتراک نگذار.

API_KEY=
BASE_URL=
MODEL_NAME=

# کلید Tavily برای ابزار جستجوی وب (search_web) — از tavily.com گرفته می‌شود.
# اگر خالی باشد، فقط ابزار ویکی‌پدیا کار می‌کند.
TAVILY_API_KEY=

# کلید OpenWeather برای ابزار آب‌وهوا (get_weather) — از openweathermap.org گرفته می‌شود.
# اگر خالی باشد، ابزار آب‌وهوا خطای «تنظیم نشده» برمی‌گرداند.
OPEN_WEATHER_KEY=
